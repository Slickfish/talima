# NEXUS environment example — copy to .env and fill in. NEVER commit .env.
# (.env is gitignored; keep it that way.)

# --- Server bind (Package A security minimum) ---
# Default is localhost-only. Setting NEXUS_HOST=0.0.0.0 exposes the API to the
# network — read THREAT_MODEL.md first; do not do this without a reverse
# proxy + TLS + real auth in front.
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000
# `python start.py --port N` beats NEXUS_PORT for that launch. Scripts that
# look for a serving NEXUS (scripts/replay_check.py) read NEXUS_PORT, so set
# it here if NEXUS runs elsewhere than 8000.

# --- Data (W1) ---
# Where the console keeps every file: kb.db, archive.db, chroma/, snapshots/,
# turn_metrics.jsonl and the three logs. Empty = data/ under the directory
# NEXUS is started from, exactly as before. `start.py --data-root D` sets it
# for one launch.
NEXUS_DATA_ROOT=

# --- Store (W3b) ---
# Where the claims, the records and the archive chain live. `sqlite` (or
# empty): kb.db and archive.db under the data root, exactly as before.
# `postgres`: one database holds every table both files hold; the data root
# keeps chroma/, snapshots/ and the logs. Any other value is refused by name
# at startup, having opened nothing. The URL's secrets (its password, in the
# userinfo or as ?password=, and ?sslpassword=) are never printed or
# recorded. Percent-encode @ / : ? # % & = and spaces in a password (@ is
# %40, / is %2F, % is %25, a space is %20): a URL libpq would not read as
# it was written is refused by name at startup (exit 2, nothing launched)
# and no line shows any of it. That is an unencoded / or @, a % that
# begins no percent-encoding, a raw space, a scheme in upper case, and a
# parameter libpq does not know (a mistyped ?passwd=). A URL libpq reads
# is shown with the values libpq holds secret blanked, the rest as written.
NEXUS_STORE=sqlite
# NEXUS_DATABASE_URL=postgresql://nexus:secret@db:5432/nexus
NEXUS_DATABASE_URL=

# --- API auth ---
# Bearer token required on all state-changing endpoints (POST/PUT/DELETE) and
# on the gated reads, the GET routes under /lineage, /belief, /governance,
# /kb/as-of, /work-units, /commitments, /actions and /whoami
# (seventeen routes: A-2's evidence reads, W4's whoami, W6's work-unit
# events, W8's record proof, W9's credential and commitment receipt, and
# W10b's action receipt);
# every other GET is open under the localhost posture (THREAT_MODEL.md). If
# unset, NEXUS generates one per process the first time it is needed (a gated
# request, or the console page) and prints it once.
# Generate a fixed one: python -c "import secrets;print(secrets.token_urlsafe(32))"
NEXUS_API_TOKEN=

# --- Identity (W4) ---
# token (or empty) keeps the bearer token above, exactly as before. proxy is
# for a process behind an identity proxy (Tailscale Serve, Cloudflare Access):
# the proxy authenticates the person and passes their login in one header,
# and NEXUS accepts a request only from a loopback peer carrying that header
# once, answers only for its owner, and takes no bearer token at all. In proxy
# mode nothing is open but /health and /healthz, and start.py launches uvicorn
# with --no-proxy-headers. Any other value is refused by name at startup.
NEXUS_AUTH_MODE=token
# The header the login arrives in (proxy mode). Behind Cloudflare Access it is
# Cf-Access-Authenticated-User-Email. The proxy must remove a client's own
# copy of it: NEXUS takes whatever a loopback peer sends.
NEXUS_IDENTITY_HEADER=Tailscale-User-Login
# The login this process answers for (proxy mode), compared exactly. Unset,
# every request is refused (403 "owner not set"): NEXUS never adopts a login.
NEXUS_OWNER_IDENTITY=

# --- Learning (RUN_CHARTER law 12) ---
# A new instance is frozen: NEXUS makes no automatic learning write (the
# association graph, reinforcement by citation, tier moves, promotion, trails)
# until you switch it on. Every claim path, every confirmed act and every
# record still write, and every record says which state it was written in.
# NEXUS_LEARNING=live switches learning on: the FZ-2 rollback literal, and
# your deliberate act. start.py fills the since-date with the day it creates
# this file (UTC, YYYY-MM-DD); it is displayed as asserted, never validated.
# Frozen with the date empty reads "frozen since: undeclared".
NEXUS_LEARNING=frozen
NEXUS_LEARNING_FROZEN_SINCE=

# --- LLM backend ---
# W3: `stub` is NEXUS's deterministic in-process provider for CI and the
# `stub` compose profile; it runs no model and checks no model server.
# `openai` is an OpenAI-compatible chat endpoint and `anthropic` the Messages
# API (the `api` compose profile); each needs its model named below. Any
# other value than the five is refused by name when NEXUS starts.
LLM_BACKEND=ollama                  # or lmstudio, or stub, or openai, or anthropic
OLLAMA_URL=http://localhost:11434
LM_STUDIO_URL=http://localhost:1234

# --- The api backends (W3) ---
# The key is read from here (or the environment) by one module and sent as a
# header; it reaches no record. The model is yours to name: NEXUS names none,
# and refuses to start an api backend whose model is unset. The record names
# the model the API REPORTS, prefixed `openai:` or `anthropic:`, never a
# local tag's shape. The extraction model may be a cheaper one; unset, it is
# the answering model.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EXTRACTION_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_EXTRACTION_MODEL=
# The embedder the api backends share: an OpenAI-compatible /embeddings
# endpoint, named by URL and model together (Anthropic offers none; an
# OpenAI-compatible chat endpoint need not serve one). Named by neither, the
# idle scans do not embed and /cortex/stats.embedder says so; one setting
# without the other is refused when NEXUS starts.
NEXUS_EMBED_URL=
NEXUS_EMBED_MODEL=
NEXUS_EMBED_API_KEY=

# --- The compose project (W3; docs/DEPLOY.md) ---
# Read by docker-compose.yml, not by NEXUS: uncomment to set. The image and
# its tag; the host name Caddy serves (localhost = its internal CA); the
# published ports; the tags Ollama pulls on first start; where the backup
# service writes (writable by uid 10001) and how many it keeps.
# NEXUS_IMAGE=ghcr.io/slickfish/talima
# NEXUS_TAG=latest
# NEXUS_DOMAIN=localhost
# NEXUS_HTTP_PORT=80
# NEXUS_HTTPS_PORT=443
# NEXUS_API_BACKEND=openai              # the api profile's backend: openai | anthropic (never LLM_BACKEND above, which is the console's)
# NEXUS_OLLAMA_MODELS=deepseek-r1:14b-qwen-distill-q4_K_M phi4-mini:3.8b-q4_K_M nomic-embed-text
# NEXUS_BACKUP_DIR=./backups
# NEXUS_BACKUP_KEEP=14
# The `hosted` profile (W3b part 5; W4 parts 0 and 3): one NEXUS per tester,
# each in a pod of its own behind the operator's identity proxy
# (docs/DEPLOY.md). The superuser is the database image's own `postgres`,
# and its password is used only when the database is first initialised;
# nothing connects as it afterwards. That first start runs
# deploy/postgres-init.sh, which makes for each tester key in NEXUS_TESTERS
# (t1 t2 t3 unless set) a role nexus_<key> that is not a superuser, with the
# password in NEXUS_<KEY>_PASSWORD, and a database nexus_<key> that the role
# owns. Only that role and the backup role may connect to it. Each tester's
# NEXUS connects as that tester's role. The script also makes the read-only
# backup role, which reads every tester's store; each tester's backup
# service builds its URL from NEXUS_BACKUP_PASSWORD. The roles are made
# once: a password changed here later changes nothing in the database. The
# passwords go into URLs: URL-safe characters only (`openssl rand -hex 24`).
# Each tester's login is the one that tester's NEXUS answers for, compared
# exactly with what the identity proxy sends (NEXUS_IDENTITY_HEADER, in the
# identity block above); unset, that tester's NEXUS answers for no one.
# The `front` network, where the pods meet the identity proxy, has a fixed
# subnet, a pool Docker hands dynamic addresses from, and the identity
# proxy's one address outside the pool: set the three together, and only
# where the defaults collide with the host's own networks.
# NEXUS_POSTGRES_PASSWORD=
# NEXUS_TESTERS="t1 t2 t3"
# NEXUS_T1_PASSWORD=
# NEXUS_T2_PASSWORD=
# NEXUS_T3_PASSWORD=
# NEXUS_BACKUP_PASSWORD=
# NEXUS_T1_OWNER=
# NEXUS_T2_OWNER=
# NEXUS_T3_OWNER=
# NEXUS_FRONT_SUBNET=172.31.240.0/24
# NEXUS_FRONT_POOL=172.31.240.0/25
# NEXUS_IDENTITY_PROXY_IP=172.31.240.250

# --- Optional web search (Phase 10a/b) ---
SEARXNG_URL=http://localhost:8888

# --- The reference gateway (W5): content from outside, judged and labelled ---
# Off (the default) is NEXUS as it was: a consented search's results go into
# the prompt as they arrive. On, each result is judged before it is used: a
# title or snippet with a clause of three tokens or more that opens with one
# of nine English commanding words (do not, never, ignore, you must...), with
# markup,
# or with NEXUS's own labels gets the whole result withheld. An instruction
# worded any other way passes. The result's address is cut down to the
# site's name, and, under the narrow render, the lines from a search and
# from stored facts say where they came from. On
# also refuses a source of stored facts that NEXUS does not know. It reduces
# what reaches the model and reports the rest; it is not a guarantee. Any
# value but `on` is off, and GET /cortex/stats says which under
# reference_gateway. docs/REFERENCE_GATEWAY.md has the measured rates.
NEXUS_REFERENCE_GATEWAY=off

# --- The recorder fails closed (W6): no answer without its record ---
# after_record (the default): the console receives an answer only after the
# record of it is written. The cost: the answer no longer appears while the
# model writes it; it arrives whole, once extraction is done. If the record
# cannot be written, the answer is withheld and the console says so.
# live: the answer appears as the model writes it, as before W6; a record
# that cannot be written is still declared, but the answer has been shown.
# Any other value is after_record. GET /cortex/stats says which is in force
# and counts the failed writes, under `recorder`.
NEXUS_ANSWER_RELEASE=after_record

# --- Anchoring (W9) ---
# Off by default: nothing leaves the machine. rfc3161 sends each signed
# block's 32-byte hash (and nothing else) to the time-stamping authority at
# NEXUS_ANCHOR_URL on the idle cycle, keeps its signed receipt beside the
# block, and a credential carries it, so a stranger can check WHEN with
# `scripts/nexus_verify.py --tsa-cert`. Any RFC 3161 authority works;
# FreeTSA's is https://freetsa.org/tsr (the run's live test used it).
NEXUS_ANCHOR=off
NEXUS_ANCHOR_URL=

# W10b — signed outbound requests (RFC 9421). With `on`, each request NEXUS's
# runtime makes for a person (the web search, the seeder's fetches) carries
# Signature-Input and Signature headers made with the instance's key (its
# public half at GET /identity), and the signature rides the action's sealed
# record, so the request's recipient can ask GET /identity/signed-action for
# the authorisation behind it. `off` (the default) sends no signature header.
NEXUS_SIGN_REQUESTS=off

# --- Replay capture (W0b) ---
# NEXUS keeps the exact text it sent to the model, so a decision can be
# re-run later and checked against what the model said then. The text is
# kept beside each record (compressed, in data/kb.db) and nothing expires it
# on its own. Set off to keep none; each record then says it was not kept.
NEXUS_KEEP_REQUESTS=on
# NEXUS sends a fresh random seed with each answer and records it, so the
# request can be sent again and the reply compared. Off sends no seed (the request as it
# was before W0b) and each record says why its seed is missing.
NEXUS_INFERENCE_SEED=on
